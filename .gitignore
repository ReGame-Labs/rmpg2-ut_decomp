# --- Game data: never commit. Users supply their own disc. ---
# (no trailing slash: in worktrees these can be symlinks to the main checkout)
/iso
/extracted
# Generated from the game binary by splat (regenerable, and derived from copyrighted code)
asm/
assets/
*.bin
*.iso
*.img
*.cue
*.chd
*.exe
*.EXE
*.mcd

# --- Build outputs ---
build/
# Generated by configure.py / splat (regenerated on every configure)
build.ninja
objdiff.json
.ninja_log
.ninja_deps
include/asm_generated
# decomp-permuter work directories (tools/ext/decomp-permuter/import.py)
nonmatchings/
*.o
*.elf
*.map
*.ld.tmp

# --- Local tooling (scripts/setup.sh rebuilds these) ---
# No trailing slashes: in worktrees these are symlinks to the main checkout
# (scripts/worktree_init.sh), and "dir/" patterns don't match symlinks.
# New installed tools go in one of these, or get a line here.
tools/venv
tools/src
tools/binutils
tools/mkpsxiso
tools/gcc
tools/ext
tools/bin
tools/redux
tools/local.env

# --- Copyrighted SDK files (Psy-Q etc.): user-supplied only ---
tools/psyq
sdk/
*.LIB
*.OBJ

# --- The private checkout of the build's original binaries (scripts/private_dir.sh; scripts/setup.sh private) ---
/private

# --- Misc ---
__pycache__
*.pyc
.splat_cache
/.splat
*.swp
.DS_Store
/ghidra/
*.rep/
*.gpr
